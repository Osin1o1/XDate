<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Widget text. Colors here only show in the launcher's widget picker; WidgetRenderer sets the real ones. -->
    <style name="WidgetText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:shadowColor">#40000000</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">3</item>
    </style>

    <style name="WidgetDay" parent="WidgetText">
        <item name="android:textColor">@color/widget_preview</item>
        <item name="android:textSize">44sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WidgetLabel" parent="WidgetText">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:layout_marginTop">3dp</item>
    </style>

    <style name="WidgetRule">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:layout_marginBottom">1dp</item>
        <item name="android:background">@color/muted</item>
    </style>

    <!-- Setup screen -->
    <style name="ConfigLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:letterSpacing">0.2</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="ConfigOption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">20dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">@color/app_fg</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="ConfigOption.Small">
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.12</item>
    </style>
</resources>
