<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:paddingHorizontal="4dp">

        <TextView
            android:id="@+id/title"
            style="@style/WidgetText"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="कार्तिक २०८३"
            android:textColor="@color/widget_preview"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView android:id="@+id/monthSub" style="@style/WidgetLabel" android:layout_marginTop="0dp" />

    </LinearLayout>

    <!-- Week rows are added by WidgetRenderer -->
    <LinearLayout
        android:id="@+id/rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:orientation="vertical" />

</LinearLayout>
