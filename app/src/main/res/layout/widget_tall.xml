<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp">

    <TextView android:id="@+id/top" style="@style/WidgetLabel" android:layout_marginBottom="4dp" android:text="आइतवार" />
    <TextView android:id="@+id/day" style="@style/WidgetDay" android:text="१" />
    <TextView android:id="@+id/label" style="@style/WidgetLabel" android:text="कार्तिक" />
    <TextView android:id="@+id/year" style="@style/WidgetLabel" android:alpha="0.8" android:text="२०८३" />
    <TextView android:id="@+id/rule" style="@style/WidgetRule" android:visibility="gone" />
    <TextView android:id="@+id/sub" style="@style/WidgetLabel" android:visibility="gone" />

</LinearLayout>
